# Wallbit API docs: https://developer.wallbit.io/docs/api-reference/authentication
# Keep secrets server-side only. Never rename this to NEXT_PUBLIC_WALLBIT_API_KEY.
WALLBIT_BASE_URL=https://api.wallbit.io
WALLBIT_API_KEY=your_wallbit_api_key_here

# Optional: leave false locally unless you want search engines to index the site.
ALLOW_INDEXING=false
